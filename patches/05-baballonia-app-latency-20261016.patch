diff --git a/src/Baballonia.OpenCVCapture/DshowRawMjpegCapture.cs b/src/Baballonia.OpenCVCapture/DshowRawMjpegCapture.cs
new file mode 100644
index 0000000..9c8bfc1
--- /dev/null
+++ b/src/Baballonia.OpenCVCapture/DshowRawMjpegCapture.cs
@@ -0,0 +1,436 @@
+using DirectShowLib;
+using Microsoft.Extensions.Logging;
+using System;
+using System.Diagnostics;
+using System.Runtime.InteropServices;
+using System.Threading;
+using System.Threading.Tasks;
+using Capture = Baballonia.SDK.Capture;
+using Cv2 = OpenCvSharp.Cv2;
+using ImreadModes = OpenCvSharp.ImreadModes;
+using Mat = OpenCvSharp.Mat;
+
+namespace Baballonia.OpenCVCapture;
+
+/// <summary>
+/// "dshowraw:" capture. Builds  capture filter -> SampleGrabber(MJPG) -> NullRenderer  with explicit pin
+/// connections so DirectShow never inserts the MJPEG Decompressor / color converter. The raw MJPEG sample is
+/// copied into a reusable buffer and decoded inline in the grabber callback straight to 1-channel grayscale
+/// (libjpeg-turbo via OpenCV). The device's default MJPG mode is used (no resolution/frame-rate negotiation). Measured on Bigeye (800x400 MJPG @ 90 fps): ~0.5 ms decode vs ~2.2 ms spent in the
+/// MJPEG Decompressor + RGB24 path, and ~0.5 ms process CPU/frame vs ~2.2 ms.
+/// </summary>
+public sealed class DshowRawMjpegCapture : Capture
+{
+    public const string Prefix = "dshowraw:";
+
+    private static readonly Guid ClsidSampleGrabber = new("C1F400A0-3F08-11D3-9F0B-006008039E37");
+    private static readonly Guid ClsidNullRenderer = new("C1F400A4-3F08-11D3-9F0B-006008039E37");
+    private static readonly TimeSpan StartTimeout = TimeSpan.FromSeconds(15);
+
+    private readonly string _deviceSpec;
+    private readonly object _graphLock = new();
+    private readonly object _latestFrameLock = new();
+    private readonly GrabberCallback _callback;
+
+    // COM objects (owned; released in Teardown)
+    private IGraphBuilder? _graph;
+    private IMediaControl? _mediaControl;
+    private ISampleGrabber? _grabber;
+    private IBaseFilter? _captureFilter;
+    private IBaseFilter? _grabberFilter;
+    private IBaseFilter? _nullFilter;
+
+    private byte[] _jpegBuffer = new byte[256 * 1024];
+    private Mat? _latestFrame;
+    private long _latestFrameSequence;
+    private long _latestFrameTimestampTick;
+    private long _framesDecoded;
+    private long _decodeFailures;
+    private long _decodeTicks;
+    private long _lastLogTick;
+    private bool _priorityRaised;
+    private long _lastWarnTick;
+    private int _generation; // bumped per StartCapture so a late Teardown from a timed-out start cannot destroy a newer graph
+
+    public override long LatestFrameSequence => Interlocked.Read(ref _latestFrameSequence);
+    public override long LatestFrameTimestampTick => Interlocked.Read(ref _latestFrameTimestampTick);
+
+    public DshowRawMjpegCapture(string source, ILogger<DshowRawMjpegCapture> logger) : base(source, logger)
+    {
+        _deviceSpec = source.StartsWith(Prefix, StringComparison.OrdinalIgnoreCase) ? source[Prefix.Length..] : source;
+        _callback = new GrabberCallback(this);
+    }
+
+    public override async Task<bool> StartCapture()
+    {
+        var generation = Interlocked.Increment(ref _generation);
+        await StopCapture().ConfigureAwait(false);
+
+        if (!OperatingSystem.IsWindows())
+        {
+            Logger.LogError("dshowraw capture is Windows only");
+            return false;
+        }
+
+        try
+        {
+            var buildTask = Task.Run(BuildAndRunGraph);
+            IsReady = await buildTask.WaitAsync(StartTimeout).ConfigureAwait(false);
+        }
+        catch (TimeoutException)
+        {
+            Logger.LogError("dshowraw start timed out for {Device}", _deviceSpec);
+            // Let the build finish in the background then tear it down, unless a newer start has superseded it.
+            _ = Task.Run(() => TeardownIfCurrent(generation));
+            IsReady = false;
+        }
+        catch (Exception e)
+        {
+            Logger.LogError(e, "dshowraw start failed for {Device}", _deviceSpec);
+            Teardown();
+            IsReady = false;
+        }
+
+        return IsReady;
+    }
+
+    public override Task<bool> StopCapture()
+    {
+        var wasRunning = _graph != null;
+        IsReady = false;
+        Teardown();
+        lock (_latestFrameLock)
+        {
+            _latestFrame?.Dispose();
+            _latestFrame = null;
+        }
+        return Task.FromResult(wasRunning);
+    }
+
+    public override Mat? AcquireRawMat() => AcquireRawFrameSnapshot().Frame;
+
+    public override RawFrameSnapshot AcquireRawFrameSnapshot()
+    {
+        lock (_latestFrameLock)
+        {
+            if (_latestFrame == null || _latestFrame.Empty())
+                return new RawFrameSnapshot(null, 0, 0, Source);
+
+            return new RawFrameSnapshot(
+                _latestFrame.Clone(),
+                Interlocked.Read(ref _latestFrameSequence),
+                Interlocked.Read(ref _latestFrameTimestampTick),
+                Source);
+        }
+    }
+
+    public override void Dispose()
+    {
+        StopCapture().GetAwaiter().GetResult();
+        base.Dispose();
+    }
+
+    // ---------------------------------------------------------------- graph
+
+    private bool BuildAndRunGraph()
+    {
+        lock (_graphLock)
+        {
+            IBaseFilter? cap = null;
+            var pins = new System.Collections.Generic.List<IPin>(4);
+            IPin? Track(IPin? pin)
+            {
+                if (pin != null) pins.Add(pin);
+                return pin;
+            }
+
+            try
+            {
+                cap = OpenDevice(_deviceSpec);
+                if (cap == null)
+                {
+                    Logger.LogError("dshowraw: video input device '{Device}' not found", _deviceSpec);
+                    return false;
+                }
+
+                var graph = (IGraphBuilder)new FilterGraph();
+                _graph = graph;
+                _captureFilter = cap;
+                cap = null;
+
+                Check(graph.AddFilter(_captureFilter, "Capture"), "AddFilter(capture)");
+
+                var grabber = (ISampleGrabber)Activator.CreateInstance(Type.GetTypeFromCLSID(ClsidSampleGrabber)!)!;
+                _grabber = grabber;
+                _grabberFilter = (IBaseFilter)grabber;
+                var mt = new AMMediaType
+                {
+                    majorType = MediaType.Video,
+                    subType = MediaSubType.MJPG,
+                    formatType = Guid.Empty
+                };
+                Check(grabber.SetMediaType(mt), "SetMediaType(MJPG)");
+                Check(graph.AddFilter(_grabberFilter, "MJPG grabber"), "AddFilter(grabber)");
+
+                _nullFilter = (IBaseFilter)Activator.CreateInstance(Type.GetTypeFromCLSID(ClsidNullRenderer)!)!;
+                Check(graph.AddFilter(_nullFilter, "Null renderer"), "AddFilter(null)");
+
+                var capPin = Track(DsFindPin.ByCategory(_captureFilter, PinCategory.Capture, 0))
+                             ?? Track(DsFindPin.ByDirection(_captureFilter, PinDirection.Output, 0));
+                if (capPin == null) throw new InvalidOperationException("no capture output pin");
+
+                // ConnectDirect = no Intelligent Connect, so no decoder gets inserted.
+                Check(graph.ConnectDirect(capPin, Track(DsFindPin.ByDirection(_grabberFilter, PinDirection.Input, 0)), null),
+                    "ConnectDirect(capture->grabber)");
+                Check(graph.ConnectDirect(Track(DsFindPin.ByDirection(_grabberFilter, PinDirection.Output, 0)),
+                        Track(DsFindPin.ByDirection(_nullFilter, PinDirection.Input, 0)), null),
+                    "ConnectDirect(grabber->null)");
+
+                grabber.SetBufferSamples(false);
+                grabber.SetOneShot(false);
+                Check(grabber.SetCallback(_callback, 0), "SetCallback(SampleCB)"); // 0 = SampleCB
+
+                _mediaControl = (IMediaControl)graph;
+                Check(_mediaControl.Run(), "Run");
+                Logger.LogInformation("dshowraw: graph running for {Device} (raw MJPG, inline grayscale decode)", _deviceSpec);
+                return true;
+            }
+            catch (Exception e)
+            {
+                Logger.LogError(e, "dshowraw: failed to build graph for {Device}", _deviceSpec);
+                if (cap != null) Marshal.FinalReleaseComObject(cap);
+                TeardownLocked();
+                return false;
+            }
+            finally
+            {
+                // DsFindPin hands out a new RCW per call; release ours (the graph keeps its own references).
+                foreach (var pin in pins)
+                {
+                    try { Marshal.ReleaseComObject(pin); } catch { }
+                }
+            }
+        }
+    }
+
+    private static IBaseFilter? OpenDevice(string spec)
+    {
+        var devices = DsDevice.GetDevicesOfCat(FilterCategory.VideoInputDevice);
+        try
+        {
+            DsDevice? chosen = null;
+            if (int.TryParse(spec, out var index))
+            {
+                // ASSUMPTION: OpenCV's DSHOW index enumerates the same VideoInputDevice category in the same order
+                // as DsDevice.GetDevicesOfCat. This is not guaranteed by either API; it only matches by assumption.
+                if (index >= 0 && index < devices.Length) chosen = devices[index];
+            }
+            else
+            {
+                foreach (var d in devices)
+                {
+                    if (d.Name.Contains(spec, StringComparison.OrdinalIgnoreCase)) { chosen = d; break; }
+                }
+            }
+
+            if (chosen == null) return null;
+            var iid = typeof(IBaseFilter).GUID;
+            chosen.Mon.BindToObject(null!, null!, ref iid, out var o);
+            return (IBaseFilter)o;
+        }
+        finally
+        {
+            foreach (var d in devices) d.Dispose();
+        }
+    }
+
+    private static void Check(int hr, string what)
+    {
+        if (hr < 0) throw new COMException($"dshowraw: {what} failed", hr);
+    }
+
+    private void Teardown()
+    {
+        lock (_graphLock) TeardownLocked();
+    }
+
+    // Waits for any in-flight build (graph lock) and tears it down only if no newer StartCapture has begun.
+    private void TeardownIfCurrent(int generation)
+    {
+        lock (_graphLock)
+        {
+            if (Volatile.Read(ref _generation) == generation)
+                TeardownLocked();
+        }
+    }
+
+    private void TeardownLocked()
+    {
+        try { _mediaControl?.Stop(); } catch { /* best effort */ }
+        try { _grabber?.SetCallback(null, 0); } catch { }
+
+        if (_graph != null)
+        {
+            try
+            {
+                if (_graph.EnumFilters(out var enumFilters) == 0 && enumFilters != null)
+                {
+                    var one = new IBaseFilter[1];
+                    var all = new System.Collections.Generic.List<IBaseFilter>();
+                    while (enumFilters.Next(1, one, IntPtr.Zero) == 0) all.Add(one[0]);
+                    foreach (var f in all)
+                    {
+                        try { _graph.RemoveFilter(f); } catch { }
+                        Marshal.ReleaseComObject(f);
+                    }
+                    Marshal.ReleaseComObject(enumFilters);
+                }
+            }
+            catch { }
+        }
+
+        ReleaseCom(ref _nullFilter);
+        ReleaseCom(ref _grabberFilter);
+        _grabber = null; // same RCW as _grabberFilter
+        ReleaseCom(ref _captureFilter);
+        _mediaControl = null; // same RCW as _graph
+        ReleaseCom(ref _graph);
+        _priorityRaised = false;
+    }
+
+    private static void ReleaseCom<T>(ref T? obj) where T : class
+    {
+        var o = obj;
+        obj = null;
+        if (o != null && Marshal.IsComObject(o))
+        {
+            try { Marshal.FinalReleaseComObject(o); } catch { }
+        }
+    }
+
+    // ---------------------------------------------------------------- callback
+
+    private void OnSample(IMediaSample sample)
+    {
+        try
+        {
+            OnSampleCore(sample);
+        }
+        finally
+        {
+            LogStats();
+        }
+    }
+
+    // Warning log limited to once per 5 s so a failing stream cannot flood the log at 90 fps.
+    private void WarnRateLimited(Exception? e, string message)
+    {
+        var now = Environment.TickCount64;
+        if (now - Interlocked.Read(ref _lastWarnTick) < 5000) return;
+        Interlocked.Exchange(ref _lastWarnTick, now);
+        if (e != null) Logger.LogWarning(e, "{Message}", message);
+        else Logger.LogWarning("{Message}", message);
+    }
+
+    private void OnSampleCore(IMediaSample sample)
+    {
+        var arrival = Stopwatch.GetTimestamp();
+        if (!_priorityRaised)
+        {
+            _priorityRaised = true;
+            RaiseCallbackThreadPriority();
+        }
+
+        var length = sample.GetActualDataLength();
+        if (length <= 0) return;
+        if (sample.GetPointer(out var ptr) < 0 || ptr == IntPtr.Zero) return;
+        if (length > _jpegBuffer.Length) _jpegBuffer = new byte[length * 2];
+        Marshal.Copy(ptr, _jpegBuffer, 0, length);
+
+        var t0 = Stopwatch.GetTimestamp();
+        Mat? gray = null;
+        try
+        {
+            gray = Cv2.ImDecode(new ReadOnlySpan<byte>(_jpegBuffer, 0, length), ImreadModes.Grayscale);
+        }
+        catch (Exception e)
+        {
+            Interlocked.Increment(ref _decodeFailures);
+            WarnRateLimited(e, "dshowraw: decode exception");
+        }
+
+        if (gray == null || gray.Empty())
+        {
+            Interlocked.Increment(ref _decodeFailures);
+            WarnRateLimited(null, "dshowraw: decode produced an empty frame");
+            gray?.Dispose();
+            return;
+        }
+
+        Interlocked.Add(ref _decodeTicks, Stopwatch.GetTimestamp() - t0);
+        Interlocked.Increment(ref _framesDecoded);
+
+        // Frame timestamp = callback arrival (QPC). The DirectShow sample time is relative to a stream start
+        // whose phase against QPC is not observable (measured +-11 ms run-to-run), so it is not used.
+        lock (_latestFrameLock)
+        {
+            _latestFrame?.Dispose();
+            _latestFrame = gray;
+            Interlocked.Increment(ref _latestFrameSequence);
+            Interlocked.Exchange(ref _latestFrameTimestampTick, arrival);
+            SignalFrameReady();
+        }
+    }
+
+    private void LogStats()
+    {
+        var now = Environment.TickCount64;
+        if (now - Interlocked.Read(ref _lastLogTick) < 5000) return;
+        Interlocked.Exchange(ref _lastLogTick, now);
+        var frames = Interlocked.Read(ref _framesDecoded);
+        var decodeMs = frames > 0 ? Interlocked.Read(ref _decodeTicks) * 1000.0 / Stopwatch.Frequency / frames : 0;
+        Logger.LogInformation("DshowRawMjpegCapture: source={Source} frames={Frames} decodeFailures={Failures} meanDecodeMs={DecodeMs:F3}",
+            Source, frames, Interlocked.Read(ref _decodeFailures), decodeMs);
+    }
+
+    [DllImport("kernel32.dll")] private static extern IntPtr GetCurrentThread();
+    [DllImport("kernel32.dll")] private static extern bool SetThreadPriority(IntPtr hThread, int nPriority);
+
+    private static void RaiseCallbackThreadPriority()
+    {
+        try
+        {
+            if (OperatingSystem.IsWindows())
+                SetThreadPriority(GetCurrentThread(), 2); // THREAD_PRIORITY_HIGHEST
+        }
+        catch
+        {
+            // Best-effort only.
+        }
+    }
+
+    private sealed class GrabberCallback(DshowRawMjpegCapture owner) : ISampleGrabberCB
+    {
+        public int SampleCB(double sampleTime, IMediaSample sample)
+        {
+            try
+            {
+                owner.OnSample(sample);
+            }
+            catch (Exception e)
+            {
+                owner.WarnRateLimited(e, "dshowraw: callback exception");
+            }
+            finally
+            {
+                // Return the buffer to the capture filter's pool immediately; relying on RCW finalization
+                // starves the allocator after a handful of frames.
+                Marshal.ReleaseComObject(sample);
+            }
+
+            return 0;
+        }
+
+        public int BufferCB(double sampleTime, IntPtr buffer, int bufferLen) => 0;
+    }
+}
