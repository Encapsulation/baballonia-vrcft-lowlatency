+/// <summary>Fixed-capacity rolling window of scores that keeps a sorted copy incrementally (no per-frame sort/alloc).</summary>
+internal sealed class ScoreWindow
+{
+    private double[] _ring = Array.Empty<double>();
+    private double[] _sorted = Array.Empty<double>();
+    private int _start;
+
+    public int Count { get; private set; }
+    public double Median => _sorted[Count / 2];
+
+    public void Add(double value, int window)
+    {
+        if (_ring.Length != window)
+            Rebuild(window);
+
+        if (Count == window)
+        {
+            var oldest = _ring[_start];
+            var idx = Array.BinarySearch(_sorted, 0, Count, oldest);
+            if (idx < 0) idx = ~idx;
+            Array.Copy(_sorted, idx + 1, _sorted, idx, Count - idx - 1);
+            _ring[_start] = value;
+            _start = (_start + 1) % window;
+            Count--;
+        }
+        else
+        {
+            _ring[(_start + Count) % window] = value;
+        }
+
+        var at = Array.BinarySearch(_sorted, 0, Count, value);
+        if (at < 0) at = ~at;
+        Array.Copy(_sorted, at, _sorted, at + 1, Count - at);
+        _sorted[at] = value;
+        Count++;
+    }
+
+    /// <summary>Element at index Count/2 of the sorted |x - median| values, found by walking outward from the median.</summary>
+    public double MedianAbsoluteDeviation(double median)
+    {
+        var n = Count;
+        var k = n / 2;
+        int l = k - 1, r = k;
+        var result = 0.0;
+        for (var i = 0; i <= k; i++)
+        {
+            if (l < 0)
+                result = Math.Abs(_sorted[r++] - median);
+            else if (r >= n)
+                result = Math.Abs(_sorted[l--] - median);
+            else
+            {
+                var dl = Math.Abs(_sorted[l] - median);
+                var dr = Math.Abs(_sorted[r] - median);
+                if (dl <= dr) { result = dl; l--; }
+                else { result = dr; r++; }
+            }
+        }
+
+        return result;
+    }
+
+    private void Rebuild(int window)
+    {
+        var old = new double[Count];
+        for (var i = 0; i < Count; i++)
+            old[i] = _ring[(_start + i) % _ring.Length];
+        var keep = Math.Min(Count, window);
+        _ring = new double[window];
+        _sorted = new double[window];
+        Array.Copy(old, old.Length - keep, _ring, 0, keep);
+        Array.Copy(_ring, _sorted, keep);
+        Array.Sort(_sorted, 0, keep);
+        _start = 0;
+        Count = keep;
+    }
+}
