+/// <summary>
+/// Single-threaded AVX2 re-implementation of OpenCV's generic INTER_AREA (non-integer scale) 8UC1 resize to 64x64.
+/// OpenCV's float accumulation order is reproduced; whether OpenCV's build fuses multiply-add is probed at construction
+/// by comparing against Cv2.Resize on synthetic data, and the resizer disables itself (callers fall back to Cv2.Resize)
+/// if no variant matches bit for bit.
+/// </summary>
+internal sealed unsafe class AreaResizer
+{
+    private const int Dst = 64;
+    private const int Blocks = Dst / 8;
+    private readonly int _srcW;
+    private readonly int _srcH;
+    private int _entries;
+    private int[] _xIdx = Array.Empty<int>();
+    private float[] _xAlpha = Array.Empty<float>();
+    private int[] _yStart = new int[Dst + 1];
+    private int[] _ySy = Array.Empty<int>();
+    private float[] _yBeta = Array.Empty<float>();
+    private readonly float[] _row;
+    private readonly float[] _buf = new float[Dst];
+    private readonly float[] _sum = new float[Dst];
+    private bool _xFma;
+    private bool _yFma;
+
+    public static bool IsSupported => Avx2.IsSupported;
+
+    public bool Usable { get; private set; }
+
+    public AreaResizer(int srcW, int srcH)
+    {
+        _srcW = srcW;
+        _srcH = srcH;
+        _row = new float[srcW + 16];
+        try
+        {
+            BuildTables();
+            Usable = SelfTest();
+        }
+        catch
+        {
+            Usable = false;
+        }
+    }
+
+    public bool Matches(int srcW, int srcH) => _srcW == srcW && _srcH == srcH;
+
+    private static List<(int di, int si, float alpha)> BuildTab(int ssize, int dsize, double scale)
+    {
+        var tab = new List<(int, int, float)>();
+        for (var dx = 0; dx < dsize; dx++)
+        {
+            var fsx1 = dx * scale;
+            var fsx2 = fsx1 + scale;
+            var cellWidth = Math.Min(scale, ssize - fsx1);
+
+            int sx1 = (int)Math.Ceiling(fsx1), sx2 = (int)Math.Floor(fsx2);
+            sx2 = Math.Min(sx2, ssize - 1);
+            sx1 = Math.Min(sx1, sx2);
+
+            if (sx1 - fsx1 > 1e-3)
+                tab.Add((dx, sx1 - 1, (float)((sx1 - fsx1) / cellWidth)));
+            for (var sx = sx1; sx < sx2; sx++)
+                tab.Add((dx, sx, (float)(1.0 / cellWidth)));
+            if (fsx2 - sx2 > 1e-3)
+                tab.Add((dx, sx2, (float)(Math.Min(Math.Min(fsx2 - sx2, 1.0), cellWidth) / cellWidth)));
+        }
+
+        return tab;
+    }
+
+    private void BuildTables()
+    {
+        var xtab = BuildTab(_srcW, Dst, (double)_srcW / Dst);
+        var counts = new int[Dst];
+        foreach (var t in xtab)
+            counts[t.di]++;
+        foreach (var c in counts)
+            _entries = Math.Max(_entries, c);
+        _xIdx = new int[Blocks * _entries * 8];
+        _xAlpha = new float[Blocks * _entries * 8];
+        var filled = new int[Dst];
+        foreach (var (di, si, alpha) in xtab)
+        {
+            var blk = di / 8;
+            var lane = di % 8;
+            var e = filled[di]++;
+            var at = (blk * _entries + e) * 8 + lane;
+            _xIdx[at] = si;
+            _xAlpha[at] = alpha;
+        }
+
+        var ytab = BuildTab(_srcH, Dst, (double)_srcH / Dst);
+        _ySy = new int[ytab.Count];
+        _yBeta = new float[ytab.Count];
+        _yStart = new int[Dst + 1];
+        for (var j = 0; j < ytab.Count; j++)
+        {
+            _ySy[j] = ytab[j].si;
+            _yBeta[j] = ytab[j].alpha;
+            _yStart[ytab[j].di + 1]++;
+        }
+
+        for (var i = 0; i < Dst; i++)
+            _yStart[i + 1] += _yStart[i];
+    }
+
+    private bool SelfTest()
+    {
+        if (!Avx2.IsSupported)
+            return false;
+
+        using var src = new Mat(_srcH, _srcW, MatType.CV_8UC1);
+        using var expected = new Mat();
+        using var actual = new Mat(Dst, Dst, MatType.CV_8UC1);
+        var state = 0x9E3779B9u;
+        var data = new byte[_srcW * _srcH];
+        for (var pass = 0; pass < 3; pass++)
+        {
+            for (var i = 0; i < data.Length; i++)
+            {
+                state = state * 1664525u + 1013904223u;
+                var noise = (int)(state >> 24);
+                data[i] = pass switch
+                {
+                    0 => (byte)noise,
+                    1 => (byte)(100 + (noise & 31) + ((i / _srcW) / 17 % 2) * 60),
+                    _ => (byte)((noise & 1) == 0 ? 0 : 255)
+                };
+            }
+
+            System.Runtime.InteropServices.Marshal.Copy(data, 0, src.Data, data.Length);
+            Cv2.Resize(src, expected, new Size(Dst, Dst), interpolation: InterpolationFlags.Area);
+            if (!expected.IsContinuous())
+                return false;
+            var exp = expected.AsSpan<byte>();
+
+            if (pass == 0)
+            {
+                var found = false;
+                foreach (var (xf, yf) in new[] { (true, true), (false, false), (true, false), (false, true) })
+                {
+                    if ((xf || yf) && !Fma.IsSupported)
+                        continue;
+                    _xFma = xf;
+                    _yFma = yf;
+                    Resize((byte*)src.Data, _srcW, (byte*)actual.Data);
+                    if (exp.SequenceEqual(actual.AsSpan<byte>()))
+                    {
+                        found = true;
+                        break;
+                    }
+                }
+
+                if (!found)
+                    return false;
+            }
+            else
+            {
+                Resize((byte*)src.Data, _srcW, (byte*)actual.Data);
+                if (!exp.SequenceEqual(actual.AsSpan<byte>()))
+                    return false;
+            }
+        }
+
+        return true;
+    }
+
+    /// <summary>Resizes the _srcW x _srcH region at <paramref name="src"/> (row pitch <paramref name="step"/>) to a continuous 64x64 byte buffer.</summary>
+    public void Resize(byte* src, long step, byte* dst)
+    {
+        int* tmp = stackalloc int[8];
+        var entries = _entries;
+        var xFma = _xFma && Fma.IsSupported;
+        var yFma = _yFma && Fma.IsSupported;
+        fixed (float* row = _row)
+        fixed (float* buf = _buf)
+        fixed (float* sum = _sum)
+        fixed (int* xi = _xIdx)
+        fixed (float* xa = _xAlpha)
+        {
+            for (var dy = 0; dy < Dst; dy++)
+            {
+                for (var j = _yStart[dy]; j < _yStart[dy + 1]; j++)
+                {
+                    var s = src + _ySy[j] * step;
+                    var x = 0;
+                    for (; x + 8 <= _srcW; x += 8)
+                        Avx.Store(row + x, Avx.ConvertToVector256Single(Avx2.ConvertToVector256Int32(s + x)));
+                    for (; x < _srcW; x++)
+                        row[x] = s[x];
+
+                    for (var blk = 0; blk < Blocks; blk++)
+                    {
+                        var acc = Vector256<float>.Zero;
+                        var baseAt = blk * entries * 8;
+                        for (var e = 0; e < entries; e++)
+                        {
+                            var idx = Avx.LoadVector256(xi + baseAt + e * 8);
+                            var a = Avx.LoadVector256(xa + baseAt + e * 8);
+                            var pv = Avx2.GatherVector256(row, idx, 4);
+                            acc = xFma ? Fma.MultiplyAdd(pv, a, acc) : Avx.Add(acc, Avx.Multiply(pv, a));
+                        }
+
+                        Avx.Store(buf + blk * 8, acc);
+                    }
+
+                    var beta = Vector256.Create(_yBeta[j]);
+                    var first = j == _yStart[dy];
+                    for (var blk = 0; blk < Blocks; blk++)
+                    {
+                        var b = Avx.LoadVector256(buf + blk * 8);
+                        Vector256<float> r;
+                        if (first)
+                            r = Avx.Multiply(b, beta);
+                        else
+                        {
+                            var cur = Avx.LoadVector256(sum + blk * 8);
+                            r = yFma ? Fma.MultiplyAdd(b, beta, cur) : Avx.Add(cur, Avx.Multiply(b, beta));
+                        }
+
+                        Avx.Store(sum + blk * 8, r);
+                    }
+                }
+
+                for (var blk = 0; blk < Blocks; blk++)
+                {
+                    Avx.Store(tmp, Avx.ConvertToVector256Int32(Avx.LoadVector256(sum + blk * 8)));
+                    for (var l = 0; l < 8; l++)
+                    {
+                        var q = tmp[l];
+                        dst[dy * Dst + blk * 8 + l] = (byte)(q < 0 ? 0 : q > 255 ? 255 : q);
+                    }
+                }
+            }
+        }
+    }
+}
