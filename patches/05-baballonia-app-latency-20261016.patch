+/// <summary>
+/// Single background writer: callers only enqueue; a BelowNormal thread drains and flushes in batches.
+/// </summary>
+public sealed class LogFileWriter : IDisposable
+{
+    private const int Capacity = 8192;
+    private const int FlushIntervalMs = 250;
+
+    private readonly StreamWriter _file;
+    private readonly Channel<string> _channel = Channel.CreateBounded<string>(new BoundedChannelOptions(Capacity)
+    {
+        FullMode = BoundedChannelFullMode.DropOldest,
+        SingleReader = true,
+        SingleWriter = false
+    });
+    private readonly Thread _thread;
+
+    public LogFileWriter(StreamWriter file)
+    {
+        _file = file;
+        _thread = new Thread(WriteLoop)
+        {
+            IsBackground = true,
+            Name = "LogFileWriter",
+            Priority = ThreadPriority.BelowNormal
+        };
+        _thread.Start();
+    }
+
+    public void Enqueue(string line) => _channel.Writer.TryWrite(line);
+
+    private void WriteLoop()
+    {
+        var reader = _channel.Reader;
+        try
+        {
+            while (reader.WaitToReadAsync().AsTask().GetAwaiter().GetResult())
+            {
+                var deadline = Environment.TickCount64 + FlushIntervalMs;
+                while (reader.TryRead(out var line))
+                {
+                    try { _file.Write(line); } catch { /* sandboxing */ }
+                    if (Environment.TickCount64 >= deadline)
+                    {
+                        try { _file.Flush(); } catch { }
+                        deadline = Environment.TickCount64 + FlushIntervalMs;
+                    }
+                }
+
+                try { _file.Flush(); } catch { }
+            }
+        }
+        catch
+        {
+            // Logging must never crash the app
+        }
+    }
+
+    public void Dispose()
+    {
+        _channel.Writer.TryComplete();
+        _thread.Join(2000);
+        try { _file.Dispose(); } catch { }
+    }
+}
